if(NOT DEFINED CNC_GAME_DATA_ROOT OR CNC_GAME_DATA_ROOT STREQUAL "")
    message(FATAL_ERROR "CNC_GAME_DATA_ROOT must be set to legally owned game data when staging")
endif()
if(NOT IS_DIRECTORY "${CNC_GAME_DATA_ROOT}")
    message(FATAL_ERROR "CNC_GAME_DATA_ROOT is not a directory: ${CNC_GAME_DATA_ROOT}")
endif()
if(NOT DEFINED CNC_STAGE_ROOT OR NOT DEFINED CNC_EXECUTABLE)
    message(FATAL_ERROR "CNC_STAGE_ROOT and CNC_EXECUTABLE are required")
endif()
file(MAKE_DIRECTORY "${CNC_STAGE_ROOT}/bin" "${CNC_STAGE_ROOT}/data")
file(COPY "${CNC_EXECUTABLE}" DESTINATION "${CNC_STAGE_ROOT}/bin")
file(COPY "${CNC_GAME_DATA_ROOT}/" DESTINATION "${CNC_STAGE_ROOT}/data")
if(DEFINED CNC_PROJECT_MANIFEST AND EXISTS "${CNC_PROJECT_MANIFEST}")
    file(COPY "${CNC_PROJECT_MANIFEST}" DESTINATION "${CNC_STAGE_ROOT}/data")
endif()
message(STATUS "Staged Zero Hour offline build at ${CNC_STAGE_ROOT}")
